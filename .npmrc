prefix=/opt/homebrew

; 所有包的安装脚本都直接运行（恢复 npm 11 及以前的行为），装全局包不会再因脚本被拦而装坏。
; 注意：这会关掉 npm 12 针对依赖投毒的脚本拦截，对项目里的 npm install 同样生效。
dangerously-allow-all-scripts=true

; 白名单：上面那项为 true 时不起作用；以后想恢复拦截，删掉上面那行即可重新生效。
allow-scripts=better-sqlite3,@larksuite/cli,@google/genai,protobufjs,esbuild,node-pty,msgpackr-extract,@opencode/cli
